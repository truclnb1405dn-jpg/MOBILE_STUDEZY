<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F5F6F8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/lr2701e3a8a3b82f6"
                android:paddingTop="73dp"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="25dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="33dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btn_back"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_back"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Deadline &amp; Nhiệm vụ" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:background="@drawable/cr10bd9d9d966"
                        android:paddingVertical="14dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvTotalTasks" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0"/>
                        <TextView android:textColor="#E0E6FD" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tổng số"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:background="@drawable/cr10bd9d9d966"
                        android:paddingVertical="14dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvDoingTasks" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0"/>
                        <TextView android:textColor="#E0E6FD" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đang làm"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:background="@drawable/cr10bd9d9d966"
                        android:paddingVertical="14dp"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvDoneTasks" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0"/>
                        <TextView android:textColor="#E0E6FD" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hoàn thành"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="21dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/btn_add_task"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:background="@drawable/sd9e3e8sw2cr10bffffff"
                    android:layout_marginEnd="16dp"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/ivSearchTask"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_kinhlup" />
                    <EditText
                        android:id="@+id/edtSearchTask"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Tìm kiếm deadline..."
                        android:inputType="text"
                        android:paddingVertical="12dp"
                        android:textSize="14sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ruarg55nipw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cr10bffa629"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/r9ht1qfbkilv"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_add"
                        android:scaleType="fitXY" />
                </LinearLayout>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginHorizontal="21dp"
                android:layout_marginBottom="25dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <LinearLayout android:id="@+id/filterAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/s000000sw1cr8lr2701e3a8a1877f2" android:paddingVertical="6dp" android:paddingHorizontal="16dp" android:layout_marginEnd="12dp" android:orientation="horizontal">
                        <TextView android:id="@+id/tvFilterAll" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tất cả"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/filterToday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/s94989bsw1cr8bffffff" android:paddingVertical="6dp" android:paddingHorizontal="16dp" android:layout_marginEnd="12dp" android:orientation="horizontal">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/rafa4kq09efb"
                            app:shapeAppearanceOverlay="@style/cr8"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_fire"
                            android:scaleType="fitXY" />
                        <TextView android:id="@+id/tvFilterToday" android:textColor="#666666" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hôm nay"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/filterWeek" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/s94989bsw1cr8bffffff" android:paddingVertical="6dp" android:paddingHorizontal="16dp" android:layout_marginEnd="12dp" android:orientation="horizontal">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/rmtsav65dgmi"
                            app:shapeAppearanceOverlay="@style/cr8"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_calendar"
                            android:scaleType="fitXY" />
                        <TextView android:id="@+id/tvFilterWeek" android:textColor="#666666" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tuần này"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/filterCompleted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/s94989bsw1cr8bffffff" android:paddingVertical="6dp" android:paddingHorizontal="16dp" android:orientation="horizontal">
                        <com.google.android.material.imageview.ShapeableImageView
                            app:shapeAppearanceOverlay="@style/cr8"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_hoanthanh"
                            android:scaleType="fitXY" />
                        <TextView android:id="@+id/tvFilterCompleted" android:textColor="#666666" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hoàn thành"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="21dp"
                android:layout_marginBottom="28dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="21dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="40dp"
                android:gravity="center"
                android:text="Bài tập hôm nay bạn đã hoàn thành tất cả \uD83C\uDF89"
                android:textColor="#4CAF50"
                android:textSize="16sp"
                android:textStyle="bold|italic"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- Thanh menu-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="15dp"
            android:paddingEnd="12dp"
            android:paddingBottom="15dp"
            android:weightSum="4">

            <!-- Trang chủ -->
            <LinearLayout
                android:id="@+id/menu_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/ic_home"
                    android:padding="6dp"
                    android:contentDescription="Trang chủ"
                    android:src="@drawable/ic_home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Trang chủ"
                    android:textColor="#1E3A8A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Lịch -->
            <LinearLayout
                android:id="@+id/menu_schedule"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="Lịch"
                    android:src="@drawable/ic_calendar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Lịch"
                    android:textColor="#8A8A8A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nhiệm vụ -->
            <LinearLayout
                android:id="@+id/menu_task"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="Nhiệm vụ"
                    android:src="@drawable/ic_assignment"
                    android:background="@drawable/bg_tab_selected" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Nhiệm vụ"
                    android:textColor="#8A8A8A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Cài đặt -->
            <LinearLayout
                android:id="@+id/menu_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="Cài đặt"
                    android:background="@drawable/ic_settings"
                    android:src="@drawable/ic_settings" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Cài đặt"
                    android:textColor="#1E3A8A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
