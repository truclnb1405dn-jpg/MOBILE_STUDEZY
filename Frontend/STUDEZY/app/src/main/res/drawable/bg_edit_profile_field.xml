<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nền trắng -->
    <solid android:color="#FFFFFF"/>

    <!-- Bo góc mềm hơn -->
    <corners android:radius="10dp"/>

    <!-- Viền nhẹ -->
    <stroke
        android:width="1dp"
        android:color="#D9E3E8"/>

    <!-- Padding bên trong -->
    <padding
        android:left="8dp"
        android:right="8dp"
        android:top="8dp"
        android:bottom="8dp"/>

</shape>